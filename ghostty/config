# Theme
theme = "Catppuccin Mocha"

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 16

# Window
background-opacity = 0.9
background-blur = 20
window-padding-x = 10
window-padding-y = 5,0
window-decoration = none
window-padding-color = extend
maximize = true
confirm-close-surface = false

# Mac settings
macos-option-as-alt = true

# Cursor
cursor-style = block_hollow
mouse-hide-while-typing = true

# Scrolling
scrollback-limit = 1000

# Links (partial replacement for Alacritty hints)
# link = "(ipfs:|ipns:|magnet:|mailto:|gemini://|gopher://|https://|http://|news:|file:|git://|ssh:|ftp://)[^\\u0000-\\u001F\\u007F-\\u009F<>\"\\\\s{-}\\^⟨⟩`]+"
link-url = true
