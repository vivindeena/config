{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pnpm dlx": "deny",
      "rm *": "deny",
      "kill *": "deny",
      "git commit *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git checkout --force *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "halt *": "deny",
      "poweroff *": "deny",
      "sudo rm *": "deny",
      "sudo shutdown *": "deny",
      "sudo reboot *": "deny",
      "sudo kill *": "deny",
      "sudo killall *": "deny",
      "mkfs *": "deny",
      "dd if=*": "deny",
      "format *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "bash *": "deny",
      "sh *": "deny",
      "zsh *": "deny",
      "fish *": "deny",
      "ksh *": "deny",
      "csh *": "deny",
      "tcsh *": "deny",
      "python *": "deny",
      "python3 *": "deny",
      "node *": "deny",
      "nodejs *": "deny",
      "perl *": "deny",
      "ruby *": "deny",
      "php *": "deny",
      "lua *": "deny",
      "tcl *": "deny",
      "expect *": "deny",
      "source *": "deny",
      ". *": "deny",
      "./*": "deny",
      "exec *": "deny",
      "eval *": "deny",
      "nohup *": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "ask"
  }
}
